{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "frontend/dist" } },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/manifest.json", "dest": "/frontend/manifest.json" },
    { "src": "/sw.js", "dest": "/frontend/sw.js" },
    { "src": "/favicon.ico", "dest": "/frontend/favicon.ico" },
    { "src": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp)$", "dest": "/frontend/$1.$2" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
