# Tixar environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ─── Python Engine (optional) ───────────────────────────────────────────────
# URL of the running Tixar Python reasoning engine (FastAPI).
# Leave blank to run in JavaScript-only (offline) mode.
# When set, the hybrid bridge (engineBridge.js) sends inconclusive local
# diagnoses here for semantic enhancement.
#
# Local development:   http://localhost:8000
# Production:          https://your-engine-domain.com
VITE_PYTHON_ENGINE_URL=

# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
