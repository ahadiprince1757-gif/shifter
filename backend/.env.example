# Backend environment variables
# Rename this file to .env for local development.

PORT=3001
ALLOWED_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# SUPABASE CREDENTIALS
# Get these from: Supabase Dashboard -> Project Settings -> API
# ─────────────────────────────────────────────────────────────

# Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=

# Supabase Anon / Public Key (starts with eyJhbGci...)
SUPABASE_KEY=

# Supabase Service Role Key (starts with eyJhbGci... - Secret Admin Key needed for push_db seeding script)
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# RENDER DEPLOY HOOK
# Get from: Render Dashboard -> shifter-api -> Settings -> Deploy Hook
# ─────────────────────────────────────────────────────────────
RENDER_DEPLOY_HOOK_URL=
